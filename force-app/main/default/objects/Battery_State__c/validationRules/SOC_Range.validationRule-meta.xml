<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SOC_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
State_Of_Charge__c &lt; 0,
State_Of_Charge__c &gt; 100
)</errorConditionFormula>
    <errorMessage>SOC must be between 0 and 100.</errorMessage>
</ValidationRule>
