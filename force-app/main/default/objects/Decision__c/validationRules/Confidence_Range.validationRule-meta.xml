<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Confidence_Range</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
Confidence__c &lt; 0,
Confidence__c &gt; 100
)</errorConditionFormula>
    <errorMessage>Confidence must be between 0 and 100.</errorMessage>
</ValidationRule>
