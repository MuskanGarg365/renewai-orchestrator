# Copy to .env.local. Vite only exposes variables prefixed with VITE_.
# live = call Salesforce Apex REST (default), fixture = bundled JSON demo fallback
VITE_DATA_MODE=live
# 15-minute aligned UTC timestamp, or "now". Seed data covers 2026-10-09 UTC.
VITE_AS_OF=2026-10-09T06:30:00Z
# Override only if the REST base path differs.
# VITE_APEX_BASE_PATH=/services/apexrest/renewai/v1
```

Then run `cp .env.example .env.local` inside the bundle folder.